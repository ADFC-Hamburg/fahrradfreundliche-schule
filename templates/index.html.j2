<!DOCTYPE html>
<html lang="de">

<head>
	<meta charset="utf-8">
	<meta name="application-name" content="{{ appname }}" />{% if version %} <!--{{ version }}-->{% endif%}
	<title>Server Hello World</title>
	<link rel="icon" type="image/png" href="{{ url_for(static, filename='favicon/favicon.png') }}" sizes="32x32" />
	<link rel="icon" type="image/svg+xml" href="{{ url_for(static, filename='favicon/favicon.svg') }}" sizes="any" />
</head>

<body>{% if custom[conf.LOGO_KEY][conf.APP_KEY] %}
	<header>
		<img src="{{ custom[conf.LOGO_KEY][conf.APP_KEY] }}" />
	</header>
{% endif %}
	<form method="post" action="/" enctype="multipart/form-data">
		{{ form.csrf_token }}
		<div id="personaldata">{% for field in form.get_inputfields() %}
			<p>{{ field.label }} {{ field() }}</p>{% endfor %}
		</div>
		<div id="questions">{% for field, upload in form.get_questionfields() %}
			<div>
				{{ field.label }}
				{{ field() }}
				{{ upload() }}
			</div>{% endfor %}
		</div>
{% if form.privacy_consent or form.storage_consent %}
		<div id="compliance">{% if form.privacy_consent %}
			<h2>Datenschutz</h2>
			{{ form.privacy_consent }}<label for="{{ form.privacy_consent.id }}"> Ich {% if contact[conf.URL_KEY][conf.PRIVACY_KEY] %}nehme die <a href="{{ contact[conf.URL_KEY][conf.PRIVACY_KEY] }}">Datenschutzerklärung</a> zur Kenntnis und {% endif %}willige in die elektronische Datenverarbeitung {% if contact[conf.URL_KEY][conf.PRIVACY_KEY] %}gemäß Datenschutzerklärung {% endif %}ein.</label>{% endif %}{% if form.storage_consent %}
			<h2>E-Mail-Versand</h2>
			{{ form.storage_consent }}<label for="{{ form.storage_consent.id }}"> Mit Absenden des Formulars willige ich ein, dass meine Daten für eventuelle Rückfragen elektronisch gespeichert und verarbeitet werden. Wir geben die Daten nicht an Dritte weiter. Diese Einwilligung kann jederzeit mit Wirkung für die Zukunft widerrufen werden.</label>{% endif %}
		</div>
{% endif %}
		<input type="submit" value="Submit">
	</form>

	<footer>
		<nav>{% if contact[conf.URL_KEY][conf.LEGAL_KEY] %}
			<a href="{{ contact[conf.URL_KEY][conf.LEGAL_KEY] }}">Legal Notice</a>{% endif %}{% if contact[conf.URL_KEY][conf.PRIVACY_KEY] %}
			<a href="{{ contact[conf.URL_KEY][conf.PRIVACY_KEY] }}">Privacy Policy</a>{% endif %}
		</nav>
	</footer>

	<script src="{{ url_for(static, filename='js/form_validation.js') }}"></script>
</body>

</html>
